# ==============================================================================
# Travel Planner Agent - Environment Configuration Example
# ==============================================================================

# Application Environment (development | production | test)
ENV=development

# Logging Level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# LLM Providers (Primary: Groq, Fallback: OpenRouter)
# Secrets: Keep private and never commit actual key values
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Places API Provider (Foursquare Places API)
FOURSQUARE_API_KEY=your_foursquare_api_key_here

# SQLite Database Persistence
DATABASE_URL=data/travel.db

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:8501,http://localhost:3000,http://127.0.0.1:8501,http://127.0.0.1:3000

# Concurrency & Latency Controls
LLM_MAX_CONCURRENT=3
LLM_DEADLINE_S=22
AGENT_TIMEOUT_S=48

# API Protection & Rate Limiting
RATE_LIMIT_PER_MIN=5
DAILY_JOB_LIMIT=100

# Server Port
PORT=8000

# Prometheus Metrics Endpoint (/metrics)
ENABLE_METRICS=false
